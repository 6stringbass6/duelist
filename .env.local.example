# 복사해서 .env.local 로 저장 (git 에 올라가지 않음). 값만 채우세요.

# ── DB (npm run db:push) ─────────────────────────────
# Supabase 대시보드 → 프로젝트 → 상단 "Connect" → "Session pooler" 연결 문자열 (IPv4 호환)
# DB 비밀번호: Settings → Database → Reset database password
SUPABASE_DB_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── E2E (npm run e2e) ────────────────────────────────
E2E_URL=https://<your-game>.vercel.app
E2E_USER=<테스트 계정 아이디>
E2E_PASS=<테스트 계정 비밀번호>
DEV_SECRET_CODE=<server/.env 의 DEV_SECRET_CODE 와 동일>

# ── 배포 확인 (npm run deploy:status) ─────────────────
GITHUB_REPO=6stringbass6/duelist
GITHUB_TOKEN=
# Vercel: https://vercel.com/account/tokens 토큰 / 프로젝트 Settings → General 의 Project ID
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Render: Account Settings → API Keys / 서비스 URL 의 srv-xxxx
RENDER_API_KEY=
RENDER_SERVICE_ID=
# Render 서버 URL (/health 확인용)
SERVER_URL=https://<your-server>.onrender.com
